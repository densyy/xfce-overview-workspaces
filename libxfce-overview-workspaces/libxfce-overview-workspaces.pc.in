prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: @PACKAGE_TARNAME@
Description: Library for xfce-overview-workspaces
Requires: @XFCE_OVERVIEW_WORKSPACES_REQUIRES@
Version: @PACKAGE_VERSION@
Libs: -L${libdir} -lxfce-overview-workspaces
Cflags: -I${includedir}/xfce-overview-workspaces
