/**
 * SECTION:version
 * @short_description: Variables and functions to check version of libxfce-overview-workspaces
 *
 * Provides version information macros, useful for checks in configure scripts
 * and to write code against different versions of libxfce-overview-workspaces that do not
 * provide the same API.
 */

#ifndef __LIBXFCE_OVERVIEW_WORKSPACES_VERSION__
#define __LIBXFCE_OVERVIEW_WORKSPACES_VERSION__

#if !defined(__LIBXFCE_OVERVIEW_WORKSPACES_H_INSIDE__) && !defined(LIBXFCE_OVERVIEW_WORKSPACES_COMPILATION)
#error "Only <libxfce-overview-workspaces/libxfce-overview-workspaces.h> can be included directly."
#endif

/**
 * LIBXFCE_OVERVIEW_WORKSPACES_MAJOR_VERSION:
 *
 * Return value: the major version number of the libxfce-overview-workspaces library, from the
 * headers used at application compile time, rather than from the library
 * linked against at application run time.
 * (e.g. in libxfce-overview-workspaces version 0.7.1 this is 0.)
 */
#define LIBXFCE_OVERVIEW_WORKSPACES_MAJOR_VERSION (@LIBXFCE_OVERVIEW_WORKSPACES_MAJOR_VERSION@)

/**
 * LIBXFCE_OVERVIEW_WORKSPACES_MINOR_VERSION:
 *
 * Return value: the minor version number of the libxfce-overview-workspaces library, from the
 * headers used at application compile time, rather than from the library
 * linked against at application run time.
 * (e.g. in libxfce-overview-workspaces version 0.7.1 this is 7.)
 */
#define LIBXFCE_OVERVIEW_WORKSPACES_MINOR_VERSION (@LIBXFCE_OVERVIEW_WORKSPACES_MINOR_VERSION@)

/**
 * LIBXFCE_OVERVIEW_WORKSPACES_MICRO_VERSION:
 *
 * Return value: the micro version number of the libxfce-overview-workspaces library, from the
 * headers used at application compile time, rather than from the library
 * linked against at application run time.
 * (e.g. in libxfce-overview-workspaces version 0.7.1 this is 1.)
 */
#define LIBXFCE_OVERVIEW_WORKSPACES_MICRO_VERSION (@LIBXFCE_OVERVIEW_WORKSPACES_MICRO_VERSION@)

/**
 * LIBXFCE_OVERVIEW_WORKSPACES_CHECK_VERSION:
 * @major: major version (e.g. 0 for version 0.7.1)
 * @minor: minor version (e.g. 7 for version 0.7.1)
 * @micro: micro version (e.g. 1 for version 0.7.1)
 *
 * Return value: %TRUE if the version of the libxfce-overview-workspaces header files
 * is the same as or newer than the passed-in version, %FALSE
 * otherwise.
 */
#define LIBXFCE_OVERVIEW_WORKSPACES_CHECK_VERSION(major,minor,micro) \
	(LIBXFCE_OVERVIEW_WORKSPACES_MAJOR_VERSION>(major) || \
		(LIBXFCE_OVERVIEW_WORKSPACES_MAJOR_VERSION==(major) && \
			LIBXFCE_OVERVIEW_WORKSPACES_MINOR_VERSION>(minor)) || \
		(LIBXFCE_OVERVIEW_WORKSPACES_MAJOR_VERSION==(major) && \
			LIBXFCE_OVERVIEW_WORKSPACES_MINOR_VERSION==(minor) && \
			LIBXFCE_OVERVIEW_WORKSPACES_MICRO_VERSION>=(micro)))

#endif	/* __LIBXFCE_OVERVIEW_WORKSPACES_VERSION__ */
